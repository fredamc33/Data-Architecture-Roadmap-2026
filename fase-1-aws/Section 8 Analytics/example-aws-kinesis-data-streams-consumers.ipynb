#DESCRIPCIÓN DEL RETO:
#
#1. Consumo de Eventos con AWS SDK en Python (Boto3)
#------------------------------------------------------------------------------------------------------

import boto3
import time

kinesis_client = boto3.client('kinesis', region_name='us-east-1')
stream_name = 'bank-transactions-stream'
shard_id = 'shardId-000000000000'

# 1. Obtener el iterador del Shard
shard_iterator_response = kinesis_client.get_shard_iterator(
    StreamName=stream_name,
    ShardId=shard_id,
    ShardIteratorType='LATEST'
)
shard_iterator = shard_iterator_response['ShardIterator']

# 2. Bucle de sondeo (Polling loop)
while shard_iterator:
    # Máximo 5 llamadas por segundo por shard para evitar throttling (200ms de pausa)
    response = kinesis_client.get_records(ShardIterator=shard_iterator, Limit=100)
    
    records = response.get('Records', [])
    for record in records:
        data = record['Data'].decode('utf-8')
        print(f"Registro procesado: {data}")
    
    # Actualizar el iterador para el siguiente bloque de datos
    shard_iterator = response.get('NextShardIterator')
    time.sleep(0.2) # Pausa para cumplir el límite de 5 req/sec
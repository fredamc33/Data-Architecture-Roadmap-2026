#DESCRIPCIÓN DEL RETO:
#
#1. AWS SDK Python - Boto3: Enviar y Leer Registros
#------------------------------------------------------------------------------------------------------

import boto3
import json

kinesis = boto3.client('kinesis', region_name='us-east-1')
stream_name = 'TransactionEventsStream'

# 1. Producer: Enviar un registro especificando PartitionKey para enrutar a un Shard
payload = {
    "account_id": "ACC-98765",
    "amount": 250.00,
    "currency": "PEN"
}

response = kinesis.put_record(
    StreamName=stream_name,
    Data=json.dumps(payload),
    PartitionKey=payload["account_id"]  # Garantiza que registros con la misma clave vayan al mismo Shard
)

print(f"Registro enviado. Shard ID: {response['ShardId']}, SequenceNumber: {response['SequenceNumber']}")

# 2. Consumer básico: Obtener ShardIterator y leer registros
shard_iterator = kinesis.get_shard_iterator(
    StreamName=stream_name,
    ShardId=response['ShardId'],
    ShardIteratorType='LATEST'
)['ShardIterator']

records_response = kinesis.get_records(ShardIterator=shard_iterator, Limit=10)
for record in records_response['Records']:
    data = json.loads(record['Data'])
    print(f"Registro leído: {data}")

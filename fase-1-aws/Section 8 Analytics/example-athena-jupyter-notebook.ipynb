import sys
from pyspark.sql import SparkSession
from pyspark.sql.functions import col, sum as _sum, avg

# Athena inicializa la SparkSession de forma automática
# Leemos directo desde S3 utilizando Glue Data Catalog
df_sales = spark.read.table("ecommerce_db.fact_sales")

# Transformación PySpark
df_metrics = df_sales \
    .filter(col("year") == 2026) \
    .groupBy("category") \
    .agg(
        _sum("amount").alias("total_revenue"),
        avg("amount").alias("avg_ticket")
    )

# Guardar resultado en S3 / Glue Data Catalog
df_metrics.write \
    .mode("overwrite") \
    .format("parquet") \
    .saveAsTable("ecommerce_db.summary_category_2026")
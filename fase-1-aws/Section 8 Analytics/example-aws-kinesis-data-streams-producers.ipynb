#DESCRIPCIÓN DEL RETO:
#
#1. Ingesta con AWS SDK en Python (Boto3)
#------------------------------------------------------------------------------------------------------

import boto3
import json
import uuid

# Cliente de Kinesis
kinesis_client = boto3.client('kinesis', region_name='us-east-1')

# Evento de transacción bancaria
transaction_event = {
    "transaction_id": str(uuid.uuid4()),
    "account_id": "ACC-98421",
    "amount": 1500.00,
    "currency": "PEN"
}

# Enviar un registro usando PutRecord
response = kinesis_client.put_record(
    StreamName='bank-transactions-stream',
    Data=json.dumps(transaction_event),
    PartitionKey=transaction_event["account_id"] # Determina a qué Shard va
)

print(f"Registro enviado exitosamente. SequenceNumber: {response['SequenceNumber']}")
#1. Lectura y Escritura Persistente con EMRFS (s3://)
#------------------------------------------------------------------------------------------------------

from pyspark.sql import SparkSession

spark = SparkSession.builder \
    .appName("EMRStorageExample") \
    .getOrCreate()

# Lectura directa desde S3 usando EMRFS (Datos persistentes)
df_raw = spark.read.parquet("s3://my-datalake-raw-bucket/orders_2026/")

# Operación intermedia que utiliza HDFS local para caching/shuffle acelerado
df_cached = df_raw.groupBy("customer_id").count().cache()

# Escritura del resultado final hacia S3 (Persiste aun si el cluster se destruye)
df_cached.write \
    .mode("overwrite") \
    .parquet("s3://my-datalake-curated-bucket/customer_order_counts/")
